# Live AIS: https://aisstream.io (GitHub login, free)
AISSTREAM_API_KEY=''
# Weekly retail gasoline: https://www.eia.gov/opendata/ (free key)
EIA_API_KEY=
# Optional, Sentinel-1 via Copernicus Data Space: https://dataspace.copernicus.eu
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Postgres (compose.yaml). ./dev.sh fills in a random password on first run; never commit a real one.
POSTGRES_PASSWORD=
# Optional: POSTGRES_USER (aperium), POSTGRES_DB (aperium), APERIUM_DB_PORT (5434).
# Optional: DATABASE_URL overrides the connection entirely (e.g. a hosted Postgres).
STALE_SECONDS=900
